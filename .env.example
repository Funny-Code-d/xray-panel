APP_NAME="FunnyNodes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# === Безопасность ===
BCRYPT_ROUNDS=12

# === Логи ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === База данных ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vpn_panel
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# === Сессии ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === Кэш / очереди / бродкаст ===
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# === Redis / Memcached (опционально) ===
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# === AWS S3 (опционально) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# === Почта ===
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (если MAIL_MAILER=resend)
RESEND_API_KEY=
MAIL_API_KEY=

# === Фронтенд ===
FRONTEND_URL=http://localhost:5173
VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Xray-переменные (используются в сидерах и XrayConfigBuilder)
# ============================================================
# Значения по умолчанию для локальной разработки / демо.
# На проде подставляются реальные значения из админки серверов.

# --- Xray API (панель) ---
XRAY_API_SERVER=127.0.0.1:10085
XRAY_BINARY=/usr/local/bin/xray

# --- VLESS + Reality ---
XRAY_VLESS_HOST=vpn.example.com
XRAY_VLESS_PORT=443
XRAY_VLESS_API_PORT=10085
XRAY_VLESS_INBOUND_TAG=vless-reality
XRAY_VLESS_FLOW=xtls-rprx-vision
XRAY_VLESS_FINGERPRINT=firefox
XRAY_VLESS_REALITY_SNI=dl.google.com
XRAY_VLESS_REALITY_DEST=dl.google.com:443
XRAY_VLESS_REALITY_PRIVATE_KEY=
XRAY_VLESS_REALITY_PUBLIC_KEY=
XRAY_VLESS_REALITY_SHORT_ID=

# --- VMess (legacy) ---
XRAY_VMESS_HOST=vpn.example.com
XRAY_VMESS_PORT=8443
XRAY_VMESS_API_PORT=10085
XRAY_VMESS_INBOUND_TAG=vmess
XRAY_VMESS_NETWORK=ws
XRAY_VMESS_PATH=/vmess
XRAY_VMESS_ALTER_ID=0